# NFC Palawan Island — environment variables
#
# Copy this file to `.env` and replace every value.
# `.env` is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Signing key for admin session cookies. REQUIRED — minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this value immediately signs out every active admin session.
ADMIN_SESSION_SECRET=""

# Public origin of the deployment, used for absolute URLs and auth redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Skips the admin login screen while developing. Ignored entirely when
# NODE_ENV=production. Must remain "false" everywhere else.
ADMIN_AUTH_DISABLED="false"

# ---------------------------------------------------------------------------
# Seed accounts (optional)
# ---------------------------------------------------------------------------
# Passwords for the accounts created by `npm run db:seed`. If left empty a
# strong random password is generated and printed once by the seed script.
SEED_OWNER_PASSWORD=""
SEED_EDITOR_PASSWORD=""
