# MerQato — Connected Business Experiences
# Environment Variables Specification (merqato.digital)

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Admin Authentication Session Secret (32+ bytes recommended)
ADMIN_SESSION_SECRET="merqato-digital-palawan-2026-secret-key-32b"

# Host & Public Domain
NEXT_PUBLIC_APP_URL="https://merqato.digital"

# Default Initial Administrator Credentials (seeded on first bootstrap):
# Owner: admin@merqato.digital / Merqato2026!Admin
# Editor: editor@merqato.digital / Merqato2026!Editor

# Skips the admin login screen while developing (non-production only).
# Must be "false" or unset in production.
ADMIN_AUTH_DISABLED=false
